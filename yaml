services:
  db:
    image: postgres:17
    environment:
      POSTGRES_DB: sinal_acessivel
      POSTGRES_USER: sinal
      POSTGRES_PASSWORD: sinal_dev
    ports:
      - "5432:5432"
    volumes:
      - sinal_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U sinal -d sinal_acessivel"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  sinal_data: